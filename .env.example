# 复制本文件为 .env.local 后填写（Next.js 只加载 .env / .env.local，不会读取 .env.example）
# Clerk：https://dashboard.clerk.com → API Keys → Development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 登录/注册页路径与登录成功后回到本站（避免登录后一直停在 Clerk 托管页）
# 详见：https://clerk.com/docs/guides/development/clerk-environment-variables
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# MongoDB Atlas（连接串见 Atlas → Connect → Drivers）
# 不配则本地仍用 data/clerk-progress.json；上线（Vercel）建议必配
MONGODB_URI=
# 可选，默认数据库名 iaa_quiz
# MONGODB_DB_NAME=iaa_quiz
